# Cache static assets aggressively; HTML always revalidates (claim pages
# must never serve stale verdicts). Security headers site-wide.
/claim/*
  Cache-Control: public, max-age=3600, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
/data/*
  Cache-Control: public, max-age=86400, immutable
  X-Content-Type-Options: nosniff
/ai-catalog.json
  Content-Type: application/json; charset=utf-8
/llms.txt
  Content-Type: text/plain; charset=utf-8
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# Same-origin embeds: the reader frames wheels.html (design/tabs/tables) and
# data/sanskrit/*.html lessons. Cloudflare accumulates overlapping rules, so a
# narrow rule must detach the site-wide DENY before setting SAMEORIGIN.
# Regression: tests/headers-frame-policy.test.cjs.
/wheels.html
  ! X-Frame-Options
  X-Frame-Options: SAMEORIGIN
/data/sanskrit/*
  ! X-Frame-Options
  X-Frame-Options: SAMEORIGIN
