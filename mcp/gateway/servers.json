{
  "format": "svatantrya.mcp-gateway/1",
  "note": "One HTTP MCP endpoint over local stdio and configured remote Streamable HTTP servers. Tool names are prefixed <server>__<tool>. Remote servers may use allow_tools to expose a closed tool set. Edit only if a server path or endpoint changes; the registry JSON in svread is the source of truth for configured servers. translation and sleepdraw are CLI tools listed under cli_only; call them as `python3 <path> <tool> <json>`.",
  "port": 8765,
  "path": "/mcp",
  "servers": {
    "scholar": {
      "path": "/root/svread/mcp/scholar_server.py",
      "cwd": "/root/svread/mcp",
      "role": "svread: passages, evidence, wheels, certificates, essays, reviews"
    },
    "openpatala": {
      "path": "/root/openpatala/patala/mcp_server.py",
      "cwd": "/root/openpatala",
      "role": "bibliography: resolve/search/get_bundle over the work DB"
    },
    "satsang": {
      "url": "https://mcp.tantrafiles.xyz/mcp",
      "role": "public read-only directory: traditions, teachers, practices, retreats and places",
      "allow_tools": [
        "search",
        "get_topic",
        "get_teacher",
        "get_lineage",
        "list_practices",
        "get_collection",
        "list_courses",
        "get_course",
        "list_series",
        "get_series",
        "recommend",
        "fetch",
        "find_places",
        "get_place",
        "search_places",
        "list_events",
        "find_teachers",
        "get_resources",
        "get_lineage_path",
        "what_to_study",
        "guide_me",
        "find_retreats",
        "get_schedule",
        "plan_retreat",
        "compose_booking",
        "site_health",
        "list_findings",
        "next_maintenance_task"
      ]
    },
    "federation": {
      "path": "/root/trika-x/formal-trika/tools/federation_gateway.py",
      "cwd": "/root/trika-x",
      "role": "109-tool federation gateway (formal, treeka, bridge)",
      "namespace_tools": false,
      "collision_policy": "its tools are already <server>__<tool>; on a name clash the direct server wins"
    },
    "bookfactory": {
      "path": "/root/bookfactory/bf_mcp/server.py",
      "cwd": "/root/bookfactory",
      "role": "book production pipeline",
      "env": {
        "BOOKFACTORY_ROOT": "/root/bookfactory",
        "BOOKFACTORY_TRANSLATIONS": "/root/translation-work"
      }
    },
    "videofactory": {
      "path": "/root/videofactory/vf_mcp_server.py",
      "cwd": "/root/videofactory",
      "role": "video production pipeline",
      "env": {
        "VIDEOFACTORY_ROOT": "/root/videofactory"
      }
    },
    "aoc": {
      "path": "/root/aoc/mcp_server.py",
      "cwd": "/root/aoc",
      "role": "AI Onboard carousel factory (gated, receipted)"
    },
    "workspace": {
      "path": "/root/svread/mcp/gateway/workspace_server.py",
      "cwd": "/root/svread",
      "role": "read/edit the estate (scoped): ws_read, ws_write, ws_patch, ws_grep, ws_git"
    }
  },
  "cli_only": {
    "translation": {
      "path": "/root/translation-work/mcp_server.py",
      "cwd": "/root/translation-work",
      "role": "translation layers L0-L4, shastra tools",
      "reason": "prints a banner to stdout before JSON-RPC; CLI dispatch, not protocol-clean stdio MCP"
    },
    "sleepdraw": {
      "path": "/root/sleepdraw/mcp_server.py",
      "cwd": "/root/sleepdraw",
      "role": "journey renderer / sleepdraw",
      "reason": "hand-rolled JSON-RPC CLI (presets/seal_prompt/render_seal), not MCP"
    }
  }
}
