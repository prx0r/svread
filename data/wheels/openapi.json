{"openapi":"3.1.0","info":{"title":"Svatantrya Sanskrit Wheels","version":"1.0.0","description":"Sanskrit learning harness: wheels, tutor levels, machine derivations, verification. Read-only GETs over vendored bytes. Start at HARNESS.md, then harness.json."},"servers":[{"url":"https://svatantrya.net"}],"paths":{"/data/wheels/HARNESS.md":{"get":{"operationId":"getHarnessPrompt","summary":"Master prompt: how a tutor model uses this site (stages, rules, verification, pronunciation, trika-x)","responses":{"200":{"description":"The HARNESS master prompt (markdown)","content":{"text/markdown":{"schema":{"type":"string"}}}}}}},"/data/wheels/harness.json":{"get":{"operationId":"getHarness","summary":"One-fetch program: all four wheel datasets, decision tree, verify index, links","responses":{"200":{"description":"harness.json","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/data/wheels/tutor/{level}":{"get":{"operationId":"getTutorLevel","summary":"One tutor level prompt (goal, rules, drills, gate)","parameters":[{"name":"level","in":"path","required":true,"schema":{"type":"string","enum":["level-01-bases.md","level-02-endings.md","level-03-subject-verb.md","level-04-time-place.md","level-05-questions.md","level-06-karaka.md"]}}],"responses":{"200":{"description":"Level prompt (markdown)","content":{"text/markdown":{"schema":{"type":"string"}}}}}}},"/data/grammar/wheel-pack.json":{"get":{"operationId":"getGrammarPack","summary":"Vidyut machine derivations with sutra-by-sutra prakriya traces (unreviewed)","responses":{"200":{"description":"wheel-pack.json","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/data/grammar/crosscheck.json":{"get":{"operationId":"getCrosscheck","summary":"Curated-vs-machine agreement per form: agree, special (katham), gaps","responses":{"200":{"description":"crosscheck.json","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/data/wheels/karaka.json":{"get":{"operationId":"getKaraka","summary":"Karaka wheel: six relationships, sutra, vibhakti, worked examples","responses":{"200":{"description":"karaka.json","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/claim/{work}/{target}/":{"get":{"operationId":"getClaimPage","summary":"Answer-first claim page with hashes and verify steps (pre-rendered, no JS)","parameters":[{"name":"work","in":"path","required":true,"schema":{"type":"string"}},{"name":"target","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Claim page (HTML)","content":{"text/html":{"schema":{"type":"string"}}}}}}}}}
