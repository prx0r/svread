{"work": "tantraloka-a36", "n": 16, "n_pass": 0, "pushing": [], "chunks": [{"chunk": "tal-a36-p01", "verses": "36.1", "gate": "BLOCKED", "blocking": ["SOURCE_BINDING", "ABSTENTION", "CITATION_GROUNDING"], "model": "manual-muse-spark", "date": "2026-10-30", "status": "OK", "sanskrit": "āyātiratha śāstrasya kathyate@vasarāgatā /0b śrīsiddhādivinirdiṣṭā gurubhiśca nirūpitā / bhairavo bhairavī devī svacchando lākulo@ṇurāṭ", "l1": "", "l2": "", "c1": null, "argmap": null}, {"chunk": "tal-a36-p02", "verses": "36.2", "gate": "BLOCKED", "blocking": ["ABSTENTION"], "model": "manual-muse-spark", "date": "2026-10-30", "status": "OK", "sanskrit": "gahaneśo@bjajaḥ śakro guruḥ koṭyapakarṣataḥ / navabhiḥ kramaśo@dhītaṃ navakoṭipravistaram", "l1": "", "l2": "", "c1": null, "argmap": null}, {"chunk": "tal-a36-p03", "verses": "36.3", "gate": "BLOCKED", "blocking": ["COVERAGE"], "model": "manual-muse-spark", "date": "2026-10-30", "status": "OK", "sanskrit": "etaistato guruḥ koṭimātrāt pādaṃ vitīrṇavān / dakṣādibhya ubhau pādau saṃvartādibhya eva ca", "l1": "", "l2": "", "c1": null, "argmap": null}, {"chunk": "tal-a36-p04", "verses": "36.4", "gate": "BLOCKED", "blocking": ["COVERAGE"], "model": "manual-muse-spark", "date": "2026-10-30", "status": "OK", "sanskrit": "pādaṃ ca vāmanādibhyaḥ pādārdhaṃ bhārgavāya ca / pādapādaṃ tu balaye pādapādastu yo@paraḥ", "l1": "", "l2": "", "c1": null, "argmap": null}, {"chunk": "tal-a36-p05", "verses": "36.5", "gate": "BLOCKED", "blocking": ["COVERAGE"], "model": "manual-muse-spark", "date": "2026-10-30", "status": "OK", "sanskrit": "siṃhāyārdhaṃ tataḥ śiṣṭāddvau bhāgau vinatābhuve / pādaṃ vāsukināgāya khaṇḍāḥ saptadaśa tvamī", "l1": "", "l2": "", "c1": null, "argmap": null}, {"chunk": "tal-a36-p06", "verses": "36.6", "gate": "BLOCKED", "blocking": ["COVERAGE"], "model": "manual-muse-spark", "date": "2026-10-30", "status": "OK", "sanskrit": "svargādardhaṃ rāvaṇo@tha jahre rāmo@rdhamapyataḥ / vibhīṣaṇamukhādāpa guruśiṣyavidhikramāt", "l1": "", "l2": "", "c1": null, "argmap": null}, {"chunk": "tal-a36-p07", "verses": "36.7", "gate": "BLOCKED", "blocking": ["COVERAGE"], "model": "manual-muse-spark", "date": "2026-10-30", "status": "OK", "sanskrit": "khaṇḍairekānnaviṃśatyā vibhaktaṃ tadabhūttataḥ / khaṇḍaṃ khaṇḍaṃ cāṣṭakhaṇḍaṃ proktapādādibhedataḥ", "l1": "", "l2": "", "c1": null, "argmap": null}, {"chunk": "tal-a36-p08", "verses": "36.8", "gate": "BLOCKED", "blocking": ["COVERAGE"], "model": "manual-muse-spark", "date": "2026-10-30", "status": "OK", "sanskrit": "pādo mūloddhārāvuttaravṛhaduttare tathā kalpaḥ / sāṃhitakalpaskandāvanuttaraṃ vyāpakaṃ tridhā tisraḥ", "l1": "", "l2": "", "c1": null, "argmap": null}, {"chunk": "tal-a36-p09", "verses": "36.9", "gate": "BLOCKED", "blocking": ["COVERAGE"], "model": "manual-muse-spark", "date": "2026-10-30", "status": "OK", "sanskrit": "devyo@tra nirūpyante kramaśo vistāriṇaiva rūpeṇa / navame pade tu gaṇanā na kāciduktā vyavacchidāhīne", "l1": "", "l2": "", "c1": null, "argmap": null}, {"chunk": "tal-a36-p10", "verses": "36.10", "gate": "BLOCKED", "blocking": ["COVERAGE"], "model": "manual-muse-spark", "date": "2026-10-30", "status": "OK", "sanskrit": "rāmācca lakṣmaṇastasmāt siddhāstebhyo@pi dānavāḥ / guhyakāśca tatastebhyo yogino nṛvarāstataḥ", "l1": "", "l2": "", "c1": null, "argmap": null}, {"chunk": "tal-a36-p11", "verses": "36.11", "gate": "BLOCKED", "blocking": ["COVERAGE"], "model": "manual-muse-spark", "date": "2026-10-30", "status": "OK", "sanskrit": "teṣāṃ krameṇa tanmadhye bhraṣṭaṃ kālāntarādyadā / tadā śrīkaṇṭhanāthājñāvaśāt siddhā avātaram", "l1": "", "l2": "", "c1": null, "argmap": null}, {"chunk": "tal-a36-p12", "verses": "36.12", "gate": "BLOCKED", "blocking": ["COVERAGE"], "model": "manual-muse-spark", "date": "2026-10-30", "status": "OK", "sanskrit": "tryambakāmardakābhikhyaśrīnāthā advaye dvaye / dvayādvaye ca nipuṇāḥ krameṇa śivaśāsane", "l1": "", "l2": "", "c1": null, "argmap": null}, {"chunk": "tal-a36-p13", "verses": "36.13", "gate": "BLOCKED", "blocking": ["COVERAGE"], "model": "manual-muse-spark", "date": "2026-10-30", "status": "OK", "sanskrit": "ādyasya cānvayo jajñe dvitīyo duhitṛkramāt / sa cārdhatryambakābhikhyaḥ saṃtānaḥ supratiṣṭhitaḥ", "l1": "", "l2": "", "c1": null, "argmap": null}, {"chunk": "tal-a36-p14", "verses": "36.14", "gate": "BLOCKED", "blocking": ["COVERAGE"], "model": "manual-muse-spark", "date": "2026-10-30", "status": "OK", "sanskrit": "ataścārdhacatasro@tra maṭhikāḥ saṃtatikramāt / śiṣyapraśiṣyairvistīrṇāḥ śataśākhaṃ vyavasthitaiḥ", "l1": "", "l2": "", "c1": null, "argmap": null}, {"chunk": "tal-a36-p15", "verses": "36.15", "gate": "BLOCKED", "blocking": ["COVERAGE"], "model": "manual-muse-spark", "date": "2026-10-30", "status": "OK", "sanskrit": "adhyuṣṭasaṃtatisrotaḥsārabhūtarasāhṛtim / vidhāya tantrāloko@yaṃ syandate sakalānrasān", "l1": "", "l2": "", "c1": null, "argmap": null}, {"chunk": "tal-a36-p16", "verses": "36.16", "gate": "BLOCKED", "blocking": ["COVERAGE"], "model": "manual-muse-spark", "date": "2026-10-30", "status": "OK", "sanskrit": "uktāyātirupādeyabhāvo nirṇīyate@dhunā /", "l1": "", "l2": "", "c1": null, "argmap": null}]}