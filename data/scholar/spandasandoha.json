  "c1": {
   "sand-p01": {
    "song": "sand-p01",
    "essence": [
     "Śiva alone, possessing spanda, self-established, makes the inner face taste; this hero, lord of the Kula, is victorious. Kṣemarāja's commentary: whose greatness is unmeasured, who measures the world from earth to Sadāśiva in the heart, who displays creation-dissolution plays — he alone, of non-dual nature, endowed with his own autonomy-power, established in his own nature, like an ocean unmoved by world-waves, shines supreme. Recognition (pratyabhijñā) is tasting this spanda in one's own inner face."
    ],
    "essence_source": "human-sharpened-v2",
    "renders": {
     "standard": {
      "style": "standard",
      "sections": {
       "SUMMARY": "",
       "FUNCTION": "",
       "KEY TERMS": "",
       "LOCAL CONTEXT": "",
       "EXPLANATION": "",
       "RELATED": "",
       "BOUNDARY": ""
      }
     }
    },
    "rasa": {
     "dominant": "adbhuta (wonder at Śiva's spanda) with śānta (tranquility of self-established nature)",
     "sthayibhava": "vismaya (wonder) resolving into śama (tranquility)",
     "justification": "The sthāyibhāva is wonder (vismaya) at Śiva's unmeasured greatness (akalitamahimā), resolving into tranquility (śama) — the ocean unmoved by world-waves. Application: Abhinava does not explicitly name a rasa for this verse; the adbhuta/śānta reading is mine."
    }
   }
  },
