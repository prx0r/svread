{"work": "tantraloka-a20", "n": 16, "n_pass": 0, "source_edition": "", "pushing": [], "chunks": [{"chunk": "tal-a20-p01", "verses": "20.1", "gate": "BLOCKED", "blocking": ["SOURCE_BINDING", "ABSTENTION", "CITATION_GROUNDING"], "model": "manual-muse-spark", "date": "2026-10-30", "status": "OK", "sanskrit": "atha dīkṣāṃ bruve mūḍhajanāśvāsapradāyinīm", "l1": "", "l2": "", "l3": "", "l4": "", "c1": null, "argmap": null}, {"chunk": "tal-a20-p02", "verses": "20.2", "gate": "BLOCKED", "blocking": ["ABSTENTION"], "model": "manual-muse-spark", "date": "2026-10-30", "status": "OK", "sanskrit": "trikoṇe vahnisadane vahnivarṇojjvale@bhitaḥ / vāyavyapuranirdhūte kare savye sujājvale", "l1": "", "l2": "", "l3": "", "l4": "", "c1": null, "argmap": null}, {"chunk": "tal-a20-p03", "verses": "20.3", "gate": "BLOCKED", "blocking": ["COVERAGE"], "model": "manual-muse-spark", "date": "2026-10-30", "status": "OK", "sanskrit": "bījaṃ kiṃcidgṛhītvaitattathaiva hṛdayāntare / kare ca dahyamānaṃ saccintayettajjapaikayuk", "l1": "", "l2": "", "l3": "", "l4": "", "c1": null, "argmap": null}, {"chunk": "tal-a20-p04", "verses": "20.4", "gate": "BLOCKED", "blocking": ["COVERAGE"], "model": "manual-muse-spark", "date": "2026-10-30", "status": "OK", "sanskrit": "vahnidīpitaphaṭkāradhoraṇīdāhapīḍitam / bījaṃ nirbījatāmeti svasūtikaraṇākṣamam", "l1": "", "l2": "", "l3": "", "l4": "", "c1": null, "argmap": null}, {"chunk": "tal-a20-p05", "verses": "20.5", "gate": "BLOCKED", "blocking": ["COVERAGE"], "model": "manual-muse-spark", "date": "2026-10-30", "status": "OK", "sanskrit": "taptaṃ naitatprarohāya tenaiva pratyayena tu / malamāyākhyakarmāṇi mantradhyānakriyābalāt", "l1": "", "l2": "", "l3": "", "l4": "", "c1": null, "argmap": null}, {"chunk": "tal-a20-p06", "verses": "20.6", "gate": "BLOCKED", "blocking": ["COVERAGE"], "model": "manual-muse-spark", "date": "2026-10-30", "status": "OK", "sanskrit": "dagdhāni na svakāryāya nirbījapratyayaṃ tvimam / sa śrīmānsuprasanno me śaṃbhunātho nyarūpayat", "l1": "", "l2": "", "l3": "", "l4": "", "c1": null, "argmap": null}, {"chunk": "tal-a20-p07", "verses": "20.7", "gate": "BLOCKED", "blocking": ["COVERAGE"], "model": "manual-muse-spark", "date": "2026-10-30", "status": "OK", "sanskrit": "bījasyāpyatra kāryā ca yojanā kṛpayā guroḥ / yato dīkṣā sudīptatvātsthāvarāṇyapi mocayet", "l1": "", "l2": "", "l3": "", "l4": "", "c1": null, "argmap": null}, {"chunk": "tal-a20-p08", "verses": "20.8", "gate": "BLOCKED", "blocking": ["COVERAGE"], "model": "manual-muse-spark", "date": "2026-10-30", "status": "OK", "sanskrit": "yo gururjapahomārcādhyānasiddhatvamātmani / jñātvā dīkṣāṃ carettasya dīkṣā sapratyayā smṛtā", "l1": "", "l2": "", "l3": "", "l4": "", "c1": null, "argmap": null}, {"chunk": "tal-a20-p09", "verses": "20.9", "gate": "BLOCKED", "blocking": ["COVERAGE"], "model": "manual-muse-spark", "date": "2026-10-30", "status": "OK", "sanskrit": "avadhūte nirācāre tattvajñe natvayaṃ vidhiḥ / sācāraiḥ kriyate dīkṣā yā dṛṣṭapratyayānvitā", "l1": "", "l2": "", "l3": "", "l4": "", "c1": null, "argmap": null}, {"chunk": "tal-a20-p10", "verses": "20.10", "gate": "BLOCKED", "blocking": ["COVERAGE"], "model": "manual-muse-spark", "date": "2026-10-30", "status": "OK", "sanskrit": "nirācāreṇa dīkṣāyāṃ pratyayastu na gadyate / jñānaṃ svapratyayaṃ yasmānna phalāntaramarhati", "l1": "", "l2": "", "l3": "", "l4": "", "c1": null, "argmap": null}, {"chunk": "tal-a20-p11", "verses": "20.11", "gate": "BLOCKED", "blocking": ["COVERAGE"], "model": "manual-muse-spark", "date": "2026-10-30", "status": "OK", "sanskrit": "dhyānādi tu phalātsādhyamiti siddhāmatoditam / tulāśuddhiparīkṣāṃ vā kuryātpratyayayoginīm", "l1": "", "l2": "", "l3": "", "l4": "", "c1": null, "argmap": null}, {"chunk": "tal-a20-p12", "verses": "20.12", "gate": "BLOCKED", "blocking": ["COVERAGE"], "model": "manual-muse-spark", "date": "2026-10-30", "status": "OK", "sanskrit": "yathā śrītantrasadbhāve kathitā parameśinā / śrīpūrvaśāstre@pyeṣā ca sūcitā parameśinā", "l1": "", "l2": "", "l3": "", "l4": "", "c1": null, "argmap": null}, {"chunk": "tal-a20-p13", "verses": "20.13", "gate": "BLOCKED", "blocking": ["COVERAGE"], "model": "manual-muse-spark", "date": "2026-10-30", "status": "OK", "sanskrit": "ānanda udbhavaḥ kampo nidrā ghūrṇiśca pañcamī / ityevaṃvadatā śaktitāratamyābhidhāyinā", "l1": "", "l2": "", "l3": "", "l4": "", "c1": null, "argmap": null}, {"chunk": "tal-a20-p14", "verses": "20.14", "gate": "BLOCKED", "blocking": ["COVERAGE"], "model": "manual-muse-spark", "date": "2026-10-30", "status": "OK", "sanskrit": "udbhavo laghubhāvena dehagrahatirohiteḥ / deho hi pārthivo mukhyastadā mukhyatvamujjhati", "l1": "", "l2": "", "l3": "", "l4": "", "c1": null, "argmap": null}, {"chunk": "tal-a20-p15", "verses": "20.15", "gate": "BLOCKED", "blocking": ["COVERAGE"], "model": "manual-muse-spark", "date": "2026-10-30", "status": "OK", "sanskrit": "bhāvilāghavamantreṇa śiṣyaṃ dhyātvā samutplutam / karmāṇi tatrāśeṣāṇi pūrvoktānyācaredguruḥ", "l1": "", "l2": "", "l3": "", "l4": "", "c1": null, "argmap": null}, {"chunk": "tal-a20-p16", "verses": "20.16", "gate": "BLOCKED", "blocking": ["COVERAGE"], "model": "manual-muse-spark", "date": "2026-10-30", "status": "OK", "sanskrit": "uktā seyaṃ tulāśuddhidīkṣā pratyayadāyinī /", "l1": "", "l2": "", "l3": "", "l4": "", "c1": null, "argmap": null}]}