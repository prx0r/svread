[Unit]
Description=Cloudflare tunnel for mcp.sanskrit.help
After=network-online.target svatantrya-mcp.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/svatantrya-mcp.env
ExecStart=/bin/sh -c 'exec /usr/local/bin/cloudflared tunnel run --token "$TUNNEL_TOKEN"'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
